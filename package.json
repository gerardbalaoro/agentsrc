{
  "name": "agentsrc",
  "version": "0.0.1",
  "description": "agentsrc - sync configuration across AI agent harnesses",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gerardbalaoro/agentsrc.git"
  },
  "bin": {
    "agentsrc": "./dist/index.js",
    "arc": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "imports": {
    "#test/*": "./test/*",
    "#*": "./src/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --target node --outdir ./dist --banner '#!/usr/bin/env node'",
    "prepublishOnly": "bun run build",
    "format": "bun run --bun oxfmt --write .",
    "format:check": "bun run --bun oxfmt --check .",
    "lint": "bun run --bun oxlint .",
    "lint:fix": "bun run --bun oxlint --fix .",
    "typecheck": "bun check",
    "prepare": "lefthook install",
    "test": "bun test",
    "dev": "bun run ./src/index.ts",
    "changeset": "changeset",
    "version-packages": "changeset version && bun install --lockfile-only --ignore-scripts",
    "release": "bun run build && changeset publish",
    "compile": "bun run scripts/compile.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@crustjs/core": "^0.6.0",
    "@crustjs/extensions": "^0.6.0",
    "@crustjs/prompts": "^0.3.0",
    "@decimalturn/toml-patch": "3.3.2-dev",
    "@types/semver": "^7.8.0",
    "bun-types": "1.4.5-canary.20261114T140813",
    "core-js": "^3.51.0",
    "jsonc-parser": "^3.3.1",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "semver": "^7.8.6",
    "ultracite": "^8.2.0",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.4.4-canary.20261114.1",
  "patchedDependencies": {
    "@decimalturn/toml-patch@3.3.2-dev": "patches/@decimalturn%2Ftoml-patch@3.3.2-dev.patch"
  }
}
