{
  "name": "agentsrc",
  "version": "0.0.1",
  "description": "agentsrc - sync configuration across AI agent harnesses",
  "license": "AGPL-3.0",
  "bin": {
    "agentsrc": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "bun build ./index.ts --outdir ./dist",
    "prepublishOnly": "bun run build",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "bun check",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "ultracite": "^8.2.0"
  },
  "packageManager": "bun@1.4.4"
}
