{
  "name": "agentsrc",
  "version": "0.0.1",
  "description": "agentsrc - sync configuration across AI agent harnesses",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gerardbalaoro/agentsrc.git"
  },
  "bin": {
    "agentsrc": "./dist/index.js",
    "arc": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "imports": {
    "#test/*": "./test/*",
    "#*": "./src/*"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --target node --outdir ./dist --banner '#!/usr/bin/env node'",
    "prepublishOnly": "bun run build",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "bun check",
    "prepare": "lefthook install",
    "dev": "bun run ./src/index.ts"
  },
  "devDependencies": {
    "@crustjs/core": "^0.6.0",
    "@crustjs/extensions": "^0.6.0",
    "@crustjs/prompts": "^0.3.0",
    "@decimalturn/toml-patch": "3.3.2-dev",
    "@types/bun": "latest",
    "@types/semver": "^7.8.0",
    "core-js": "^3.51.0",
    "jsonc-parser": "^3.3.1",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "semver": "^7.8.6",
    "ultracite": "^8.2.0",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {
    "@decimalturn/toml-patch@3.3.2-dev": "patches/@decimalturn%2Ftoml-patch@3.3.2-dev.patch"
  }
}
